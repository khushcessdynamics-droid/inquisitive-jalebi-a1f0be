# Copy to .env.local for local development, or set these in Cloudflare (build environment variables).
# Only PUBLIC values belong here: the project URL and the publishable (anon) key. Row Level Security
# protects the data. NEVER put the secret / service_role key or the database password in a VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
